{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "opencode-acp",
    "version": "1.18.0",
    "type": "module",
    "description": "Active Context Pruning — model-driven context management for OpenCode (hardened fork of DCP with 35 bug fixes)",
    "main": "./index.ts",
    "types": "./index.ts",
    "exports": {
        ".": "./index.ts",
        "./server": "./index.ts"
    },
    "scripts": {
        "verify:package": "node scripts/verify-package.mjs",
        "check:package": "npm run typecheck && npm run verify:package",
        "prepublishOnly": "npm run check:package",
        "dev": "opencode plugin dev",
        "typecheck": "tsc --noEmit",
        "test": "node --import tsx --test tests/*.test.ts",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "dcp": "tsx scripts/print.ts"
    },
    "keywords": [
        "opencode",
        "opencode-plugin",
        "plugin",
        "context",
        "pruning",
        "active-context",
        "optimization",
        "tokens",
        "acp"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/paradox8599/opencode-acp.git"
    },
    "homepage": "https://github.com/paradox8599/opencode-acp#readme",
    "author": "paradox8599",
    "license": "AGPL-3.0-or-later",
    "dependencies": {
        "@anthropic-ai/tokenizer": "^0.0.4",
        "context-compress-algorithms": "1.3.0",
        "jsonc-parser": "^3.3.1",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@opencode/plugin": "2.0.3",
        "@types/node": "^25.5.0",
        "fast-check": "^4.9.0",
        "prettier": "^3.8.1",
        "tsx": "^4.21.0",
        "typescript": "^6.0.2"
    },
    "files": [
        "index.ts",
        "lib/",
        "README.md",
        "README.zh-CN.md",
        "LICENSE",
        "NOTICE"
    ]
}
